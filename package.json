{
  "name": "best-audio-room",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build --webpack && node scripts/stamp-sw.mjs",
    "check:authz": "node scripts/check-authorization.mjs",
    "check:authz:selftest": "node scripts/verify-authorization-gate.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:legal": "node scripts/check-legal.mjs",
    "check:legal:strict": "node scripts/check-legal.mjs --strict",
    "db:backup": "node scripts/backup-d1.mjs",
    "db:export": "node scripts/export-schema.mjs",
    "db:migrate": "wrangler d1 migrations apply audioroom-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply audioroom-db --local",
    "dev": "next dev",
    "dev:seed": "node scripts/dev-seed.mjs",
    "dev:serve": "wrangler pages dev out --port 8788",
    "dev:smoke": "node scripts/dev-smoke.mjs",
    "launch:check": "node scripts/launch-check.mjs",
    "lint": "eslint",
    "native:add": "cap add android && cap add ios",
    "native:apk": "cap sync android && cd android && gradlew assembleRelease",
    "native:manifest": "node scripts/android-manifest.mjs",
    "native:sdk": "node scripts/android-local-props.mjs",
    "native:sync": "cap sync android",
    "stage:apk": "node scripts/stage-apk.mjs",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:unit": "vitest run tests/unit",
    "typecheck": "tsc --noEmit",
    "verify:schema": "node scripts/verify-schema-reconciliation.mjs",
    "verify:seats": "node scripts/verify-seat-capacity.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "firebase": "12.16.0",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "20.19.24",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "@firebase/component": "0.7.5",
    "@firebase/app": "0.16.2"
  }
}
