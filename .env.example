# MS-ROOMS environment template.
#
# Everything ships as ONE Cloudflare Pages project:
#   - static assets  -> the Next.js export in ./out
#   - the API        -> a Pages Function in functions/api/
# so the frontend and API are the same origin by default.

# Leave NEXT_PUBLIC_API_URL unset for normal deployments: lib/api.ts then
# resolves API_BASE to "" and every request is relative and same-origin.
# Set it ONLY to point the frontend at a different host during development
# (e.g. a local Worker), which reintroduces CORS + SameSite=None cookies.
# NEXT_PUBLIC_API_URL="http://localhost:8787"

# ---------------------------------------------------------------------------
# Firebase Auth (project: ms-rooms-auth / 59506321553) — sign-in only.
# Web config from Firebase Console > Project settings > Your apps.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyBgPuvvc8zt7y9dhB0_ZfeptaRAdRjZkmk"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="ms-rooms-auth.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="ms-rooms-auth"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="ms-rooms-auth.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="59506321553"
NEXT_PUBLIC_FIREBASE_APP_ID="1:59506321553:web:d5db8040d4ce22667ef730"

# Firebase App Check uses a separate reCAPTCHA v3 score key. This one is public,
# but it must be registered for the web app above in App Check. Do not reuse
# the v2 checkbox key below.
NEXT_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_V3_KEY="6LdgXbQtAAAAAJAMc3Q68CFZG8_3gKeB6hErtWlq"

# reCAPTCHA v2 checkbox site key (public) — used on the registration form.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6LeJIbwtAAAAABfH5omBJh8H-AqwRN2l9XzmdprD"

# ---------------------------------------------------------------------------
# Server-side secrets — set on the Pages project, never committed:
#   npx wrangler pages secret put <KEY> --project-name=ms-rooms
#
#   TURN_KEY_ID        Realtime TURN key ID, mints short-lived ICE credentials
#   TURN_API_TOKEN     Bearer token for generate-ice-servers (NEVER in the browser)
#   RECAPTCHA_SECRET_KEY   server-side reCAPTCHA verification
#   FIREBASE_PROJECT_ID    optional override for ID-token verification
#
# GET /api/turn calls:
#   POST https://rtc.live.cloudflare.com/v1/turn/keys/<TURN_KEY_ID>/credentials/generate-ice-servers
#   with '{"ttl":86400}'
# TURN handles NAT traversal; peers still exchange SDP/ICE through the D1-backed
# relay at /api/signal/*, which is what makes TURN the actual media path.
# ---------------------------------------------------------------------------

# Genkit server flows (local dev only — never NEXT_PUBLIC).
# GOOGLE_GENAI_API_KEY=""
